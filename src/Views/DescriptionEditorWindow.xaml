<Window x:Class="PlayGif.Views.DescriptionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Edit description" Height="700" Width="900"
        WindowStartupLocation="CenterOwner" Background="#16161e">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#33334a" BorderThickness="1" CornerRadius="4">
            <wv2:WebView2 x:Name="Editor"/>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Foreground="#8a8a9e" FontSize="12"
                       VerticalAlignment="Center" HorizontalAlignment="Left"
                       TextWrapping="Wrap" MaxWidth="520"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Click="Cancel_Click"
                        Padding="16,6" Margin="0,0,8,0" MinWidth="80"/>
                <Button Content="Save" Click="Save_Click"
                        Padding="16,6" MinWidth="80" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

<UserControl x:Class="PlayGif.PlayGifSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl>
        <!-- General Tab -->
        <TabItem Header="General">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Display" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <CheckBox Content="Enable animated descriptions"
                              IsChecked="{Binding Settings.EnableAnimatedDescriptions}"
                              Margin="0,5,0,5"/>

                    <CheckBox Content="Enable in fullscreen mode (experimental)"
                              IsChecked="{Binding Settings.EnableInFullscreen}"
                              Margin="0,5,0,5"
                              IsEnabled="{Binding Settings.EnableAnimatedDescriptions}"/>

                    <CheckBox Content="Show video poster only (no playback, keeps GIFs animated)"
                              IsChecked="{Binding Settings.UseVideoPosterOnly}"
                              Margin="0,5,0,5"
                              IsEnabled="{Binding Settings.EnableAnimatedDescriptions}"/>

                    <Separator Margin="0,15,0,15"/>

                    <TextBlock Text="Video" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                        <TextBlock Text="Video scale: " VerticalAlignment="Center" Width="140"/>
                        <ComboBox ItemsSource="{Binding VideoScaleOptions}"
                                  SelectedValue="{Binding Settings.VideoScale}"
                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                  Width="150" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Smaller scales decode fewer pixels, which helps on slower machines. Applies to every game unless you set a per-game scale from the game's PlayGif menu."
                               TextWrapping="Wrap" Opacity="0.5" Margin="0,2,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                        <TextBlock Text="Max video height (px): " VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Settings.MaxVideoHeight, UpdateSourceTrigger=PropertyChanged}"
                                 Width="50" VerticalAlignment="Center"/>
                        <TextBlock Text="  (0 = no limit, 360 = 360p, 480 = 480p)" VerticalAlignment="Center" Opacity="0.5"/>
                    </StackPanel>

                    <Separator Margin="0,15,0,15"/>

                    <TextBlock Text="Cache" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <CheckBox Content="Auto-cache media for offline use"
                              IsChecked="{Binding Settings.AutoCacheMedia}"
                              Margin="0,5,0,5"
                              IsEnabled="{Binding Settings.EnableAnimatedDescriptions}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                        <TextBlock Text="Max cache per game (MB): " VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Settings.MaxCachePerGameMB, UpdateSourceTrigger=PropertyChanged}"
                                 Width="60" VerticalAlignment="Center"
                                 IsEnabled="{Binding Settings.AutoCacheMedia}"/>
                    </StackPanel>

                    <Separator Margin="0,15,0,15"/>

                    <TextBlock Text="Descriptions" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Fetch rich descriptions with animated content from Steam store pages."
                               TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.7"/>
                    <Button Content="Fetch Steam descriptions for all games"
                            Click="BulkFetchButton_Click"
                            HorizontalAlignment="Left"
                            Padding="12,6" Margin="0,0,0,5"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Theme Support Tab -->
        <TabItem Header="Theme Support">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Theme Compatibility" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.7"
                               Text="PlayGif renders inside your theme's own description panel, and themes lay that panel out differently. It detects the active view automatically and re-attaches when you switch between Grid and Details, so no configuration is normally needed."/>

                    <Border BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16"
                            BorderBrush="{DynamicResource NormalBorderBrush}">
                        <StackPanel>
                            <TextBlock Text="Having trouble with your theme?" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,10"
                                       Text="If descriptions do not animate, appear blank, or show in the wrong place, run the layout report below. It records what PlayGif found in your theme's visual tree, which is what a bug report needs."/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Run layout report"
                                        Click="DiagnosticsButton_Click"
                                        Padding="12,6" Margin="0,0,8,0"/>
                                <Button Content="Open log folder"
                                        Click="OpenLogFolderButton_Click"
                                        Padding="12,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Separator Margin="0,0,0,16"/>

                    <TextBlock Text="Compatibility Patches" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"
                               Text="Per-theme layout overrides appear here when a theme needs one. None are required at the moment — view detection and re-attachment are handled automatically for every theme."/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.55" FontStyle="Italic"
                               Text="Found a theme that needs a patch? Attach the layout report to an issue on GitHub and it can be added here."/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Advanced Tab -->
        <TabItem Header="Advanced">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <CheckBox Content="Enable debug mode (WebView2 DevTools)"
                              IsChecked="{Binding Settings.EnableDebugMode}"
                              Margin="0,5,0,5"/>

                    <Separator Margin="0,15,0,15"/>

                    <TextBlock Text="Video conversion" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Videos play as H.264 MP4 automatically. A video available only as WebM is converted in the background when FFmpeg is present, and plays as-is otherwise. Nothing to configure unless FFmpeg lives outside your PATH."
                               TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.7"/>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                        <TextBlock Text="FFmpeg path: " VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Settings.FfmpegPath, UpdateSourceTrigger=PropertyChanged}"
                                 Width="350" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Leave empty to auto-detect from PATH."
                               TextWrapping="Wrap" Opacity="0.5" Margin="0,2,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>

<UserControl x:Class="PlayGif.PlayGifSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl>
        <!-- General Tab -->
        <TabItem Header="General">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Display" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <CheckBox Content="Enable animated descriptions"
                              IsChecked="{Binding Settings.EnableAnimatedDescriptions}"
                              Margin="0,5,0,5"/>

                    <CheckBox Content="Enable in fullscreen mode (experimental)"
                              IsChecked="{Binding Settings.EnableInFullscreen}"
                              Margin="0,5,0,5"
                              IsEnabled="{Binding Settings.EnableAnimatedDescriptions}"/>

                    <CheckBox Content="Show video poster only (no playback, keeps GIFs animated)"
                              IsChecked="{Binding Settings.UseVideoPosterOnly}"
                              Margin="0,5,0,5"
                              IsEnabled="{Binding Settings.EnableAnimatedDescriptions}"/>

                    <Separator Margin="0,15,0,15"/>

                    <TextBlock Text="Video" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,4">
                        <TextBlock Text="Default video scale (all games): " VerticalAlignment="Center" Width="200"/>
                        <ComboBox ItemsSource="{Binding VideoScaleOptions}"
                                  SelectedValue="{Binding Settings.VideoScale}"
                                  SelectedValuePath="Value" DisplayMemberPath="Label"
                                  Width="170" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,3"
                               Text="Lower scale = less work for your machine. A video at 50% has a quarter of the pixels to decode and draw every frame, so dropping the scale is the most effective way to reduce stutter and CPU/GPU load on slower hardware."/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.5" Margin="0,0,0,10"
                               Text="This is the global default applied to every game. To override a single game, right-click it and use PlayGif → Video scale."/>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,4">
                        <TextBlock Text="Max video height (px): " VerticalAlignment="Center" Width="200"/>
                        <TextBox Text="{Binding Settings.MaxVideoHeight, UpdateSourceTrigger=PropertyChanged}"
                                 Width="60" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.5" Margin="0,0,0,4"
                               Text="Caps how tall a single video can get, regardless of scale. 0 = no limit, 360 = 360p, 480 = 480p. Useful for very tall clips that would otherwise dominate the description."/>

                    <Separator Margin="0,15,0,15"/>

                    <TextBlock Text="Cache" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <CheckBox Content="Auto-cache media for offline use"
                              IsChecked="{Binding Settings.AutoCacheMedia}"
                              Margin="0,5,0,5"
                              IsEnabled="{Binding Settings.EnableAnimatedDescriptions}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                        <TextBlock Text="Max cache per game (MB): " VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Settings.MaxCachePerGameMB, UpdateSourceTrigger=PropertyChanged}"
                                 Width="60" VerticalAlignment="Center"
                                 IsEnabled="{Binding Settings.AutoCacheMedia}"/>
                    </StackPanel>

                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,10,0,6"
                               Text="Convert cached GIFs and other animations to MP4. A GIF stores every frame as a full image, so an MP4 is typically a fraction of the size and is hardware-decoded, which cuts both disk use and playback cost. Descriptions switch to the MP4 automatically."/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.5" Margin="0,0,0,8"
                               Text="Requires FFmpeg. Originals are removed only after a conversion succeeds."/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <Button Content="Convert cached media to MP4"
                                Click="ConvertToMp4Button_Click"
                                Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Repair description links"
                                Click="RepairLinksButton_Click"
                                Padding="12,6"/>
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Opacity="0.5" Margin="0,0,0,5"
                               Text="Repair is only needed if a description shows a broken image after converting — it re-points links at the converted files."/>

                    <Separator Margin="0,15,0,15"/>

                    <TextBlock Text="Descriptions" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Fetch rich descriptions with animated content from Steam store pages."
                               TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.7"/>
                    <Button Content="Fetch Steam descriptions for all games"
                            Click="BulkFetchButton_Click"
                            HorizontalAlignment="Left"
                            Padding="12,6" Margin="0,0,0,5"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Theme Support Tab -->
        <TabItem Header="Theme Support">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Theme Compatibility" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Opacity="0.7"
                               Text="PlayGif detects the active view automatically and re-attaches when you switch between Grid and Details, so no configuration is normally needed."/>

                    <Border BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,16"
                            BorderBrush="{DynamicResource NormalBorderBrush}">
                        <StackPanel>
                            <TextBlock Text="Having trouble with your theme?" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,10"
                                       Text="If descriptions do not animate, appear blank, or show in the wrong place, run the layout report below. It records what PlayGif found in your theme's visual tree, which is what a bug report needs."/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Run layout report"
                                        Click="DiagnosticsButton_Click"
                                        Padding="12,6" Margin="0,0,8,0"/>
                                <Button Content="Open log folder"
                                        Click="OpenLogFolderButton_Click"
                                        Padding="12,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Separator Margin="0,0,0,16"/>

                    <TextBlock Text="Compatibility Patches" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,0,0,8"
                               Text="Per-theme layout overrides appear here when a theme needs one. None are required at the moment — view detection and re-attachment are handled automatically for every theme."/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Known Issues Tab -->
        <TabItem Header="Known Issues">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="Theme Compatibility" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,10"
                               Text="Playnite has no official support for animated descriptions, so PlayGif injects its renderer into whatever description panel your theme builds. Themes lay that out very differently, and other extensions modify the same panel."/>

                    <TextBlock Text="What you might run into" FontWeight="SemiBold" Margin="0,4,0,6"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="12,0,0,4"
                               Text="- Visual glitches: clipped text, blank gaps, content in the wrong place, or flicker while scrolling"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="12,0,0,4"
                               Text="- Some themes may not work at all"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="12,0,0,4"
                               Text="- Problems that only appear alongside another extension, since several also modify the details view (HowLongToBeat, achievements plugins, screenshot viewers)"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="12,0,0,12"
                               Text="- Fullscreen mode is experimental and disabled by default"/>

                    <TextBlock Text="Under investigation" FontWeight="SemiBold" Margin="0,4,0,6"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,4"
                               Text="Some fixes depend on timing that varies by machine, theme and library size, so they ship as attempts rather than confirmed fixes. If one of these still happens, a report with a log is what makes it fixable."/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="12,0,0,12"
                               Text="- 1.0.2: descriptions reverting to plain text after restarting Playnite (issue #2)"/>

                    <TextBlock Text="Reporting a problem" FontWeight="SemiBold" Margin="0,4,0,6"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,6"
                               Text="Reports are welcome. Some theme layouts may be out of reach, but a report helps identify which ones. Include:"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="12,0,0,4"
                               Text="1. A layout report — Theme Support tab, 'Run layout report'"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="12,0,0,4"
                               Text="2. The name of your theme"/>
                    <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="12,0,0,12"
                               Text="3. Any other extensions that touch the details view"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Report an issue"
                                Click="ReportIssueButton_Click"
                                Padding="12,6" Margin="0,0,8,0"/>
                        <Button Content="Project page"
                                Click="ProjectPageButton_Click"
                                Padding="12,6"/>
                    </StackPanel>

                    <Separator Margin="0,0,0,12"/>

                    <TextBlock TextWrapping="Wrap" Opacity="0.6"
                               Text="The long-term fix is official Playnite support for animated content in descriptions, which would remove the need to inject anything at all."/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- Advanced Tab -->
        <TabItem Header="Advanced">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <CheckBox Content="Enable debug mode (WebView2 DevTools)"
                              IsChecked="{Binding Settings.EnableDebugMode}"
                              Margin="0,5,0,5"/>

                    <Separator Margin="0,15,0,15"/>

                    <TextBlock Text="Video conversion" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="Videos play as H.264 MP4 automatically. A video available only as WebM is converted in the background when FFmpeg is present, and plays as-is otherwise. Nothing to configure unless FFmpeg lives outside your PATH."
                               TextWrapping="Wrap" Margin="0,0,0,8" Opacity="0.7"/>

                    <StackPanel Orientation="Horizontal" Margin="0,5,0,5">
                        <TextBlock Text="FFmpeg path: " VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Settings.FfmpegPath, UpdateSourceTrigger=PropertyChanged}"
                                 Width="350" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Leave empty to auto-detect from PATH."
                               TextWrapping="Wrap" Opacity="0.5" Margin="0,2,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
